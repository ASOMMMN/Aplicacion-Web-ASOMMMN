# URL base de la API (apps/api). Requerida: next.config.ts la usa para
# armar el connect-src del CSP, y el build de producción falla sin ella.
# Local: http://localhost:3001 (o el PORT de apps/api)
# Producción (Netlify): https://reclutamiento-asommmn.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# Host (sin esquema) del bucket S3 donde se guardan los archivos (debe
# coincidir con AWS_S3_BUCKET/AWS_REGION de apps/api). next.config.ts lo usa
# para permitir ese host exacto en frame-src/img-src del CSP: las vistas
# previas embeben ahí la URL firmada de S3. Opcional: si se omite, usa el
# valor por defecto hardcodeado en next.config.ts (el bucket actual).
NEXT_PUBLIC_S3_HOST=asommmn-reclutamiento.s3.us-east-2.amazonaws.com
