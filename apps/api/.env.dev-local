# ─────────────────────────────────────────────────────────────────────────────
# Entorno de desarrollo LOCAL — Mongo local descartable (mongodb-memory-server),
# nunca Atlas. No contiene secretos reales: todos los valores son de prueba.
#
# Uso:
#   1. npm run dev:db:local        (otra terminal, déjala corriendo)
#   2. npm run seed:dev:local      (una vez, siembra datos ficticios)
#   3. ENV_FILE=.env.dev-local npm run dev:api
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001

MONGODB_URI=mongodb://127.0.0.1:27018/asommmn_dev

JWT_SECRET=dev-local-secret-no-usar-en-produccion
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-local-refresh-secret-no-usar-en-produccion
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# S3/Cloudinary: valores dummy — basta para que arranque; subir/ver archivos
# reales no funcionará contra esta base local (los documentos del seed son
# solo metadata, sin bytes reales en ningún bucket).
AWS_ACCESS_KEY_ID=dev-local-dummy
AWS_SECRET_ACCESS_KEY=dev-local-dummy
AWS_REGION=us-east-2
AWS_S3_BUCKET=dev-local-dummy-bucket
CLOUDINARY_CLOUD_NAME=dev-local-dummy
CLOUDINARY_API_KEY=dev-local-dummy
CLOUDINARY_API_SECRET=dev-local-dummy
STORAGE_PATH=./uploads-dev-local

RESEND_API_KEY=
RESEND_FROM=notificaciones@dev.local
EMAIL_VERIFICATION_REQUIRED=false

OPENAI_API_KEY=

ADMIN_EMAIL=admin.prueba@asommmn.dev
ADMIN_PASSWORD=PruebaAdmin123!
ADMIN_NOMBRE=Admin
ADMIN_APELLIDOS=De Prueba

ENABLE_TEST_ENDPOINTS=true
SOC_MODE=false

NEXT_PUBLIC_API_URL=http://localhost:3001
