NODE_ENV=development
PORT=3001

MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/asommmn?retryWrites=true&w=majority

JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh
JWT_REFRESH_EXPIRES_IN=7d

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_CVS=asommmn-cvs
MINIO_BUCKET_REPORTES=asommmn-reportes

# Resend (correo transaccional, vía API HTTPS — NO SMTP). Necesario porque
# el plan Free de Render bloquea el tráfico saliente en los puertos SMTP
# (25, 465, 587); la API HTTPS de Resend usa el puerto 443 y no se ve
# afectada. RESEND_API_KEY se genera en https://resend.com/api-keys.
# RESEND_FROM debe ser una dirección de un dominio verificado en
# https://resend.com/domains (ej. notificaciones@tudominio.com); si no
# coincide con un dominio verificado, Resend rechaza el envío.
RESEND_API_KEY=re_change_me
RESEND_FROM=notificaciones@tudominio.com

# Verificación de correo (true = obligatoria; false = cuenta activa de inmediato)
EMAIL_VERIFICATION_REQUIRED=false

# Habilita endpoints de solo-testing (ej. GET /auth/test-verificar-email).
# NUNCA poner en true fuera de un entorno local de desarrollo.
ENABLE_TEST_ENDPOINTS=false

# URL base del frontend, usada para armar los links de los correos (verificación,
# recuperación de contraseña, avisos de expediente/comentarios, etc.)
FRONTEND_URL=http://localhost:3000

# ── Chatbot ──────────────────────────────────────────────────────────────────
# Número de WhatsApp de soporte (formato internacional, ej: 5212291234567)
# Se muestra al postulante cuando el chatbot no puede resolver su duda en 3 intentos.
CHATBOT_WHATSAPP_NUMERO=
