# ── Backend ──────────────────────────────────────────
NODE_ENV=development
PORT=3001

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/asommmn?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh
JWT_REFRESH_EXPIRES_IN=7d

# Almacenamiento en disco
STORAGE_PATH=./uploads
BACKEND_PUBLIC_URL=http://localhost:3001

# Resend (correo transaccional vía API) — https://resend.com/api-keys
RESEND_API_KEY=re_change_me

# IA
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Verificación de correo (true = obligatoria; false = cuenta activa de inmediato)
EMAIL_VERIFICATION_REQUIRED=false

# URL base del frontend, usada para armar los links de los correos
FRONTEND_URL=http://localhost:3000

# Seed: administrador inicial
ADMIN_EMAIL=admin@asommmn.com
ADMIN_PASSWORD=change_me_in_production
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDOS=Sistema

# ── Frontend ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
