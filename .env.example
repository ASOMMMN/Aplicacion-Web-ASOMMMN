# ─────────────────────────────────────────────────────────────────────────────
# ASOMMMN — variables de entorno
#
# Este archivo es idéntico en la raíz y en apps/api. Mantenerlos sincronizados.
# - Backend: copiar a apps/api/.env (la API carga .env del directorio donde corre).
# - Frontend: la sección final va en apps/web/.env.local.
# Nunca commitear valores reales.
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ─────────────────────────────────────────────────────────────────
# Entorno: development | production | test
NODE_ENV=development
# Puerto HTTP de la API
PORT=3001

# ── Base de datos ────────────────────────────────────────────────────────────
# Cadena de conexión de MongoDB Atlas (obligatoria)
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/asommmn?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────────────────────────
# Secreto para firmar access tokens (obligatorio; usar un valor largo y aleatorio)
JWT_SECRET=change_me_in_production
# Vigencia del access token
JWT_EXPIRES_IN=15m
# Sin efecto actualmente: el refresh token es opaco (se guarda en BD) y su
# vigencia de 7 días está fija en auth.service.ts. Se conservan porque
# env.validation.ts las declara.
JWT_REFRESH_SECRET=change_me_refresh
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origin exacto del frontend permitido en producción (sin wildcards ni listas).
# En desarrollo se ignora y se permite localhost.
CORS_ORIGIN=https://tu-frontend.netlify.app

# URL base del frontend; se usa para armar los links de los correos
FRONTEND_URL=http://localhost:3000

# ── Almacenamiento: AWS S3 (actual) ──────────────────────────────────────────
# Credenciales de un usuario IAM con permisos sobre el bucket (obligatorias)
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
# Región del bucket
AWS_REGION=us-east-2
# Nombre del bucket donde se guardan los archivos (obligatorio)
AWS_S3_BUCKET=change_me

# ── Almacenamiento: Cloudinary (legacy) ──────────────────────────────────────
# Ya no se usa para archivos nuevos, pero env.validation.ts todavía las exige:
# la API no arranca si faltan. Cualquier valor no vacío sirve si no se usa.
CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me

# ── Almacenamiento: disco local (legacy) ─────────────────────────────────────
# Carpeta para archivos antiguos con storageType 'local' (main.ts la crea al arrancar)
STORAGE_PATH=./uploads
# Sin efecto actualmente (declarada en env.validation.ts pero no se lee)
BACKEND_PUBLIC_URL=http://localhost:3001

# ── Correo (Resend, vía API HTTPS) ───────────────────────────────────────────
# API key de https://resend.com/api-keys (sin ella no se envían correos)
RESEND_API_KEY=re_change_me
# Remitente; debe pertenecer a un dominio verificado en Resend
RESEND_FROM=notificaciones@tudominio.com
# true = el usuario debe verificar su correo; false = cuenta activa de inmediato
EMAIL_VERIFICATION_REQUIRED=false

# ── IA (OpenAI) ──────────────────────────────────────────────────────────────
# API key de OpenAI. Si falta, la extracción IA (CV, cursos, docs personales)
# responde iaDisponible=false y el resto de la app sigue funcionando.
OPENAI_API_KEY=sk-change_me
# Modelo usado para la extracción
OPENAI_MODEL=gpt-4o-mini

# ── Administrador inicial (seed al arrancar) ─────────────────────────────────
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=change_me_in_production
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDOS=Sistema

# ── Chatbot ──────────────────────────────────────────────────────────────────
# WhatsApp de soporte en formato internacional (ej. 5212291234567); se muestra
# cuando el chatbot no resuelve la duda en 3 intentos. Opcional.
CHATBOT_WHATSAPP_NUMERO=

# ── Desarrollo ───────────────────────────────────────────────────────────────
# Habilita endpoints solo de testing (ej. GET /auth/test-verificar-email).
# Requiere además NODE_ENV=development. NUNCA en true en producción.
ENABLE_TEST_ENDPOINTS=false
# true = logs en JSON para el dashboard de `npm run dev` (scripts/hacker-dev.js,
# que ya lo activa solo). Dejar en false para logs legibles en consola.
SOC_MODE=false

# ── Frontend (apps/web/.env.local) ───────────────────────────────────────────
# URL de la API que consume el frontend (obligatoria; el build falla si falta)
NEXT_PUBLIC_API_URL=http://localhost:3001
